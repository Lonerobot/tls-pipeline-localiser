version 12.2 v3
Gizmo {
 help "This gizmo adds an overall glow (haze) to an image based on the luminace of things.\nIt is based on a real effect taking place in a glass lens.\nFor proof of concept it can also be used to remove the effect off a plate.\nThis is to be used to help integrating CG elements into plates or make full CG shots look more photographic.\n\nMarian (c) 2009"
 addUserKnob {20 User l "MPC Lenshaze"}
 addUserKnob {41 value l Color T Multiply1.value}
 addUserKnob {41 pop3 l "Wide Blur Size" T Blur1.pop3}
 addUserKnob {41 size_1 l "Core Blur Size" T Blur2.size}
 addUserKnob {41 mix l "Wide Blur Mix" T Merge1.mix}
 addUserKnob {41 which l Mix T Dissolve1.which}
 addUserKnob {41 op2 l KeyOff T Switch2.op2}
 addUserKnob {41 op l Operation T Switch1.op}
}
 Input {
  inputs 0
  name Input
  xpos -431
  ypos -338
 }

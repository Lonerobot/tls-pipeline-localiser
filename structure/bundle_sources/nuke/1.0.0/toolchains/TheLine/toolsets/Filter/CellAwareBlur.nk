  KernelDescription "2 \"IterativeMaskedBlur\" iterate pixelWise 4868b2f437900eafa19c6684bb0fba1243d8ac3787ff71372c0df27c5ad2578f 3 \"src\" Read Random \"mask\" Read Random \"dst\" Write Point 0 0 0"
  kernelSource "kernel IterativeMaskedBlur : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> src;\n  Image<eRead, eAccessRandom, eEdgeClamped> mask;\n  Image<eWrite> dst;\n\n  void process(int2 pos) \{\n    // If the current pixel is outside the mask (e.g., a black line or different color), \n    // we bypass the blur and output the original pixel to preserve crisp edges.\n    if (mask(pos.x, pos.y).w < 0.5f) \{\n      dst() = src(pos.x, pos.y);\n      return;\n    \}\n\n    float4 sumColor = float4(0.0f);\n    float sumWeight = 0.0f;\n\n    // 3x3 matrix for 1-pixel iterative diffusion\n    for (int j = -1; j <= 1; j++) \{\n      for (int i = -1; i <= 1; i++) \{\n        \n        // Only sample the neighbor if it is also allowed by the mask\n        if (mask(pos.x + i, pos.y + j).w > 0.5f) \{\n          \n          // Custom weights to simulate a smoother, more rounded Gaussian diffusion\n          // Center = 2.0, Edges = 1.0, Corners = 0.5\n          float weight = (i == 0 && j == 0) ? 2.0f : ((i*j != 0) ? 0.5f : 1.0f);\n          \n          sumColor += src(pos.x + i, pos.y + j) * weight;\n          sumWeight += weight;\n        \}\n      \}\n    \}\n    \n    // Normalize the accumulated color values and output\n    dst() = sumColor / sumWeight;\n  \}\n\};"
  rebuild ""
  rebuild_finalise ""
  name IterativeBlur324
  xpos 15
  ypos 321
  disable {{"!(size > 8)"}}
 }

 BlinkScript {
  inputs 2
  recompileCount 11
  ProgramGroup 1
  KernelDescription "2 \"MultiDirBlur\" iterate pixelWise 6b748b30e11b7ca6f9a1a8df8fc6794fcb1bd585e871d281365ee414dc286926 3 \"src\" Read Random \"mask\" Read Random \"dst\" Write Point 3 \"BlurRadius\" Float 1 AACgQQ== \"NumDirections\" Int 1 EAAAAA== \"AngleOffset\" Float 1 AAC0Qg== 3 \"radius\" 1 1 \"numDirections\" 1 1 \"angleOffset\" 1 1 3 \"iRadius\" Int 1 1 AAAAAA== \"sigmaSq2\" Float 1 1 AAAAAA== \"angleOffsetRad\" Float 1 1 AAAAAA=="
  kernelSource "kernel MultiDirBlur : ImageComputationKernel<ePixelWise>\n\{\n    Image<eRead, eAccessRandom, eEdgeClamped> src;\n    Image<eRead, eAccessRandom, eEdgeClamped> mask;\n    Image<eWrite> dst;\n\n    param:\n        float radius;\n        int   numDirections;\n        float angleOffset; // in degrees, 0 to (180 / numDirections)\n\n    local:\n        int   iRadius;\n        float sigmaSq2;\n        float angleOffsetRad;\n\n    void define() \{\n        defineParam(radius,        \"BlurRadius\",      20.0f);\n        defineParam(numDirections, \"NumDirections\",   16);\n        defineParam(angleOffset,   \"AngleOffset\",     90.0f);\n    \}\n\n    void init() \{\n        iRadius         = (int)radius;\n        float sigma     = max(radius / 2.0f, 0.1f);\n        sigmaSq2        = 2.0f * sigma * sigma;\n        // Convert once in init, not per pixel\n        angleOffsetRad  = angleOffset * 3.14159265f / 180.0f;\n    \}\n\n    float4 blur1D(int2 pos, float dx, float dy) \{\n        float4 sumColor  = float4(0.0f);\n        float  sumWeight = 0.0f;\n\n        for (int k = 0; k <= iRadius; k++) \{\n            int nx = pos.x + (int)floor((float)k * dx + 0.5f);\n            int ny = pos.y + (int)floor((float)k * dy + 0.5f);\n\n            if (mask(nx, ny).w < 0.5f) break;\n\n            float weight  = exp(-(float)(k * k) / sigmaSq2);\n            sumColor     += src(nx, ny) * weight;\n            sumWeight    += weight;\n        \}\n\n        for (int k = 1; k <= iRadius; k++) \{\n            int nx = pos.x - (int)floor((float)k * dx + 0.5f);\n            int ny = pos.y - (int)floor((float)k * dy + 0.5f);\n\n            if (mask(nx, ny).w < 0.5f) break;\n\n            float weight  = exp(-(float)(k * k) / sigmaSq2);\n            sumColor     += src(nx, ny) * weight;\n            sumWeight    += weight;\n        \}\n\n        return (sumWeight > 0.0f) ? sumColor / sumWeight : src(pos.x, pos.y);\n    \}\n\n    void process(int2 pos) \{\n        if (mask(pos.x, pos.y).w < 0.5f) \{\n            dst() = src(pos.x, pos.y);\n            return;\n        \}\n\n        float4 result    = float4(0.0f);\n        int    validDirs = 0;\n\n        for (int d = 0; d < numDirections; d++) \{\n            // angleOffsetRad shifts all directions uniformly\n            float angle = 3.14159265f * (float)d / (float)numDirections + angleOffsetRad;\n            float dx    = cos(angle);\n            float dy    = sin(angle);\n\n            result    += blur1D(pos, dx, dy);\n            validDirs += 1;\n        \}\n\n        dst() = result / (float)validDirs;\n    \}\n\};"
  rebuild ""
  MultiDirBlur_BlurRadius {{size/2}}
  MultiDirBlur_NumDirections {{quality}}
  MultiDirBlur_AngleOffset 0
  rebuild_finalise ""
  name BlinkScript_blank33
  xpos 15
  ypos 153
 }
 BlinkScript {
  inputs 2
  recompileCount 11
  ProgramGroup 1
  KernelDescription "2 \"MultiDirBlur\" iterate pixelWise 6b748b30e11b7ca6f9a1a8df8fc6794fcb1bd585e871d281365ee414dc286926 3 \"src\" Read Random \"mask\" Read Random \"dst\" Write Point 3 \"BlurRadius\" Float 1 AACgQQ== \"NumDirections\" Int 1 EAAAAA== \"AngleOffset\" Float 1 AAC0Qg== 3 \"radius\" 1 1 \"numDirections\" 1 1 \"angleOffset\" 1 1 3 \"iRadius\" Int 1 1 AAAAAA== \"sigmaSq2\" Float 1 1 AAAAAA== \"angleOffsetRad\" Float 1 1 AAAAAA=="
  kernelSource "kernel MultiDirBlur : ImageComputationKernel<ePixelWise>\n\{\n    Image<eRead, eAccessRandom, eEdgeClamped> src;\n    Image<eRead, eAccessRandom, eEdgeClamped> mask;\n    Image<eWrite> dst;\n\n    param:\n        float radius;\n        int   numDirections;\n        float angleOffset; // in degrees, 0 to (180 / numDirections)\n\n    local:\n        int   iRadius;\n        float sigmaSq2;\n        float angleOffsetRad;\n\n    void define() \{\n        defineParam(radius,        \"BlurRadius\",      20.0f);\n        defineParam(numDirections, \"NumDirections\",   16);\n        defineParam(angleOffset,   \"AngleOffset\",     90.0f);\n    \}\n\n    void init() \{\n        iRadius         = (int)radius;\n        float sigma     = max(radius / 2.0f, 0.1f);\n        sigmaSq2        = 2.0f * sigma * sigma;\n        // Convert once in init, not per pixel\n        angleOffsetRad  = angleOffset * 3.14159265f / 180.0f;\n    \}\n\n    float4 blur1D(int2 pos, float dx, float dy) \{\n        float4 sumColor  = float4(0.0f);\n        float  sumWeight = 0.0f;\n\n        for (int k = 0; k <= iRadius; k++) \{\n            int nx = pos.x + (int)floor((float)k * dx + 0.5f);\n            int ny = pos.y + (int)floor((float)k * dy + 0.5f);\n\n            if (mask(nx, ny).w < 0.5f) break;\n\n            float weight  = exp(-(float)(k * k) / sigmaSq2);\n            sumColor     += src(nx, ny) * weight;\n            sumWeight    += weight;\n        \}\n\n        for (int k = 1; k <= iRadius; k++) \{\n            int nx = pos.x - (int)floor((float)k * dx + 0.5f);\n            int ny = pos.y - (int)floor((float)k * dy + 0.5f);\n\n            if (mask(nx, ny).w < 0.5f) break;\n\n            float weight  = exp(-(float)(k * k) / sigmaSq2);\n            sumColor     += src(nx, ny) * weight;\n            sumWeight    += weight;\n        \}\n\n        return (sumWeight > 0.0f) ? sumColor / sumWeight : src(pos.x, pos.y);\n    \}\n\n    void process(int2 pos) \{\n        if (mask(pos.x, pos.y).w < 0.5f) \{\n            dst() = src(pos.x, pos.y);\n            return;\n        \}\n\n        float4 result    = float4(0.0f);\n        int    validDirs = 0;\n\n        for (int d = 0; d < numDirections; d++) \{\n            // angleOffsetRad shifts all directions uniformly\n            float angle = 3.14159265f * (float)d / (float)numDirections + angleOffsetRad;\n            float dx    = cos(angle);\n            float dy    = sin(angle);\n\n            result    += blur1D(pos, dx, dy);\n            validDirs += 1;\n        \}\n\n        dst() = result / (float)validDirs;\n    \}\n\};"
  rebuild ""
  MultiDirBlur_BlurRadius {{parent.BlinkScript_blank33.MultiDirBlur_BlurRadius}}
  MultiDirBlur_NumDirections {{parent.BlinkScript_blank33.MultiDirBlur_NumDirections}}
  MultiDirBlur_AngleOffset {{parent.BlinkScript_blank33.MultiDirBlur_AngleOffset}}
  rebuild_finalise ""
  name BlinkScript_blank34
  xpos 15
  ypos 201
 }
 BlinkScript {
  inputs 2
  recompileCount 6
  ProgramGroup 1
  KernelDescription "2 \"IterativeMaskedBlur\" iterate pixelWise 4868b2f437900eafa19c6684bb0fba1243d8ac3787ff71372c0df27c5ad2578f 3 \"src\" Read Random \"mask\" Read Random \"dst\" Write Point 0 0 0"
  kernelSource "kernel IterativeMaskedBlur : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> src;\n  Image<eRead, eAccessRandom, eEdgeClamped> mask;\n  Image<eWrite> dst;\n\n  void process(int2 pos) \{\n    // If the current pixel is outside the mask (e.g., a black line or different color), \n    // we bypass the blur and output the original pixel to preserve crisp edges.\n    if (mask(pos.x, pos.y).w < 0.5f) \{\n      dst() = src(pos.x, pos.y);\n      return;\n    \}\n\n    float4 sumColor = float4(0.0f);\n    float sumWeight = 0.0f;\n\n    // 3x3 matrix for 1-pixel iterative diffusion\n    for (int j = -1; j <= 1; j++) \{\n      for (int i = -1; i <= 1; i++) \{\n        \n        // Only sample the neighbor if it is also allowed by the mask\n        if (mask(pos.x + i, pos.y + j).w > 0.5f) \{\n          \n          // Custom weights to simulate a smoother, more rounded Gaussian diffusion\n          // Center = 2.0, Edges = 1.0, Corners = 0.5\n          float weight = (i == 0 && j == 0) ? 2.0f : ((i*j != 0) ? 0.5f : 1.0f);\n          \n          sumColor += src(pos.x + i, pos.y + j) * weight;\n          sumWeight += weight;\n        \}\n      \}\n    \}\n    \n    // Normalize the accumulated color values and output\n    dst() = sumColor / sumWeight;\n  \}\n\};"
  rebuild ""
  rebuild_finalise ""
  name IterativeBlur
  xpos 15
  ypos 273
  disable {{"!(size > 4)"}}
 }
 BlinkScript {

set cut_paste_input [stack 0]
version 15.1 v2
push $cut_paste_input
Group {
 name CellAwareBlur
 onCreate "node = nuke.thisNode()\n\nfor k in \[\"size\"]:\n    node\[k].setFlag(0x00000004)\n    \n\nknob_defaults = \{\n    'quality': \[16],\n\}\nfor knob_name, default_value in knob_defaults.items():\n    if knob_name in node.knobs():\n        knob = node\[knob_name]\n        value = knob.value()\n        not_default = knob.notDefault()\n        \n        knob.setDefaultValue(default_value)\n        if not_default:\n            knob.setValue(value)\n"
 knobChanged "\n\ncheck = nuke.thisNode().knob(\"inputEdge\").value()\ncontrols = nuke.thisNode().knob('CellSelect')\nif check:\n    controls.setValue(False)\nelse:\n    controls.setValue(True)\n\n"
 tile_color 0xcc804eff
 selected true
 xpos -8101
 ypos 3483
 addUserKnob {20 CellAwareBlur}
 addUserKnob {6 inputEdge l "use edge input" +STARTLINE}
 addUserKnob {20 CellSelect l "cell selection" n 1}
 addUserKnob {26 enableColAtxt l enable T "<span>&#8203;"}
 addUserKnob {6 enableColA l "" -STARTLINE}
 addUserKnob {18 colorA l "color A" -STARTLINE}
 colorA {0 0 0}
 addUserKnob {26 enableColBtxt l enable T "<span>&#8203;"}
 addUserKnob {6 enableColB l "" -STARTLINE}
 addUserKnob {18 colorB l "color B" -STARTLINE}
 colorB {0 0 0}
 addUserKnob {26 enableColCtxt l enable T "<span>&#8203;"}
 addUserKnob {6 enableColC l "" -STARTLINE}
 addUserKnob {18 colorC l "color C" -STARTLINE}
 colorC {0 0 0}
 addUserKnob {26 enableColDtxt l enable T "<span>&#8203;"}
 addUserKnob {6 enableColD l "" -STARTLINE}
 addUserKnob {18 colorD l "color D" -STARTLINE}
 colorD {0 0 0}
 addUserKnob {20 endGroup n -1}
 addUserKnob {6 colorA_panelDropped l "panel dropped state" +HIDDEN +STARTLINE}
 addUserKnob {6 color_rgb_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {6 colorB_panelDropped l "panel dropped state" +HIDDEN +STARTLINE}
 addUserKnob {6 color_rgb_1_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {6 colorC_panelDropped l "panel dropped state" +HIDDEN +STARTLINE}
 addUserKnob {6 colorD_panelDropped l "panel dropped state" +HIDDEN +STARTLINE}
 addUserKnob {7 size R 0 200}
 addUserKnob {41 tolerance T mask1.tolerance}
 addUserKnob {3 quality t "This is a multi-directionnal blur. This number defines the number of directions. Higher is smoother but might be slower." R 0 16}
 quality 17
 addUserKnob {26 credit l "" +STARTLINE +INVISIBLE T "Renaud Tissandie - 2026"}
}

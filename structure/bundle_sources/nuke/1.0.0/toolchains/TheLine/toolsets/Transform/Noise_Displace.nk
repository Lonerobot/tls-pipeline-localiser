set cut_paste_input [stack 0]
version 17.0 v3
push $cut_paste_input
Group {
 name Noise_Distort
 tile_color 0xa57aaa00
 selected true
 xpos 21
 ypos -798
 addUserKnob {20 User}
 addUserKnob {26 noise l Noise}
 addUserKnob {41 scale l Quality t "Setting directions speed to 0,0 lets you adjust quality without seeing a transate " T Reformat_Down.scale}
 addUserKnob {41 Scale T NoOp1.Scale}
 addUserKnob {41 Evolution_Speed T NoOp1.Evolution_Speed}
 addUserKnob {41 Directional_Speed T NoOp1.Directional_Speed}
 addUserKnob {41 Anim_Steps T FrameHold1.increment}
 addUserKnob {41 Blur T Blur1.size}
 addUserKnob {6 Show_Noise +STARTLINE}
}
 NoOp {
  inputs 0
  name NoOp1
  xpos -1081
  ypos -268
  addUserKnob {20 User}
  addUserKnob {7 Scale R 1 2000}
  Scale 10
  addUserKnob {7 Evolution_Speed R 0 25}
  Evolution_Speed 0.7
  addUserKnob {12 Directional_Speed}
 }
 Input {
  inputs 0
  name Input1
  xpos -506
  ypos -467
 }
 Dot {
  name Dot8
  xpos -472
  ypos -392
 }
set Nf8fd8000 [stack 0]
 Dot {
  name Dot9
  xpos -742
  ypos -392
 }
 Reformat {
  type scale
  scale 0.82
  filter impulse
  name Reformat_Down
  xpos -776
  ypos -333
 }
 Noise {
  replace true
  size {{Noise_Distort.NoOp1.Scale*parent.Reformat_Down.scale x78 260}}
  zoffset {{frame*(Noise_Distort.NoOp1.Evolution_Speed/100)}}
  translate {{frame*(Noise_Distort.NoOp1.Directional_Speed.x/100)} {frame*(Noise_Distort.NoOp1.Directional_Speed.y/100)}}
  name Noise1
  xpos -895
  ypos -268
 }
set Nf8f87e00 [stack 0]
 Reformat {

  addUserKnob {22 Script T "ff = int(nuke.Root()\['first_frame'].getValue(0))\nlf = int(nuke.Root()\['last_frame'].getValue(0))\n\nn = nuke.toNode(\"CurveTool500\")\n\nframes = \[]\n\nfor frame in range((ff-1),(lf+1)):\n\n    v = n\[\"intensitydata\"].getValueAt(frame)\n    v = v\[0]\n\n    if v == 1:\n        frames.append(frame)\n        frames.append(ff)\n#frames.insert(0,1)\n    \n#print frames\n\nnode = nuke.toNode(\"TimeWarp1\")\nnode_attr = node\['lookup']\nnode_attr.clearAnimated()\nnode_attr.setAnimated(0)\n\n\n##node_an.setKey(ff,ff)\n\nnode_an = node\['lookup'].animations()\[0]\nfor i in frames:\n    print i\n    a = node_an.setKey(i,i)\n    a.interpolation = nuke.CONSTANT\t\n" +STARTLINE}
 }
end_group

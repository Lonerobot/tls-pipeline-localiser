 name CHAR_TEMPLATE
 onCreate "\nknob = nuke.thisNode()\['rimlight_intensity']\nvalue = knob.value()\nnot_default = knob.notDefault()\nknob.setDefaultValue(\[10.0])\nif not_default:\n    knob.setValue(value)\n"
 knobChanged "\nif nuke.thisKnob().name() == \"ramp\": \n#ramp\n    if nuke.thisKnob().getValue() == 0:\n        nuke.thisNode().knob('rampdisplay').setVisible(False)\n        nuke.thisNode().knob('ramp_space').setVisible(False)\n        nuke.thisNode().knob('ramp_type').setVisible(False)\n        nuke.thisNode().knob('ramp_gamma').setVisible(False)\n        nuke.thisNode().knob('ColorRamp_p0').setVisible(False)\n        nuke.thisNode().knob('ColorRamp_p1').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n        nuke.thisNode().knob('ramp_space').setVisible(True)\n        nuke.thisNode().knob('rampdisplay').setVisible(True)\n        nuke.thisNode().knob('ramp_type').setVisible(True)\n        nuke.thisNode().knob('ramp_gamma').setVisible(True)\n        nuke.thisNode().knob('ColorRamp_p0').setVisible(True)\n        nuke.thisNode().knob('ColorRamp_p1').setVisible(True)\n\n#rimlight\nif nuke.thisKnob().name() == \"rimlight\": \n\n    if nuke.thisKnob().getValue() == 0:\n        nuke.thisNode().knob('rimlight_pos').setVisible(False)\n        nuke.thisNode().knob('rimlight_pos_help').setVisible(False)\n        nuke.thisNode().knob('rimlight_blursize').setVisible(False)\n        nuke.thisNode().knob('rimlight_color').setVisible(False)\n        nuke.thisNode().knob('rimlight_intensity').setVisible(False)\n        nuke.thisNode().knob('rimlight_space').setVisible(False)\n        nuke.thisNode().knob('rimlight_mask').setVisible(False)\n        nuke.thisNode().knob('inverse_rimlight_mask').setVisible(False)\n        nuke.thisNode().knob('rimlight_mask_space').setVisible(False)\n        nuke.thisNode().knob('rimlight_mask_help').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n        nuke.thisNode().knob('rimlight_pos').setVisible(True)\n        nuke.thisNode().knob('rimlight_pos_help').setVisible(True)\n        nuke.thisNode().knob('rimlight_blursize').setVisible(True)\n        nuke.thisNode().knob('rimlight_color').setVisible(True)\n        nuke.thisNode().knob('rimlight_intensity').setVisible(True)\n        nuke.thisNode().knob('rimlight_space').setVisible(True)\n        nuke.thisNode().knob('rimlight_mask').setVisible(True)\n        nuke.thisNode().knob('inverse_rimlight_mask').setVisible(True)\n        nuke.thisNode().knob('rimlight_mask_space').setVisible(True)\n        nuke.thisNode().knob('rimlight_mask_help').setVisible(True)\n\n#cc_shad\nif nuke.thisKnob().name() == \"cc_shad\": \n\n    if nuke.thisKnob().getValue() == 0:\n        nuke.thisNode().knob('cc_shad_space').setVisible(False)\n        nuke.thisNode().knob('Grade_Shadow_white').setVisible(False)\n        nuke.thisNode().knob('Grade_Shadow_black').setVisible(False)\n        nuke.thisNode().knob('Grade_Shadow_multiply').setVisible(False)\n        nuke.thisNode().knob('Grade_Shadow_gamma').setVisible(False)\n        nuke.thisNode().knob('cc_shad_line').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n        nuke.thisNode().knob('cc_shad_space').setVisible(True)\n        nuke.thisNode().knob('Grade_Shadow_white').setVisible(True)\n        nuke.thisNode().knob('Grade_Shadow_black').setVisible(True)\n        nuke.thisNode().knob('Grade_Shadow_multiply').setVisible(True)\n        nuke.thisNode().knob('Grade_Shadow_gamma').setVisible(True)\n        nuke.thisNode().knob('cc_shad_line').setVisible(True)\n\n#cc_shad\nif nuke.thisKnob().name() == \"cc_light\": \n\n    if nuke.thisKnob().getValue() == 0:\n        nuke.thisNode().knob('cc_light_space').setVisible(False)\n        nuke.thisNode().knob('Grade_Light_white').setVisible(False)\n        nuke.thisNode().knob('Grade_Light_black').setVisible(False)\n        nuke.thisNode().knob('Grade_Light_multiply').setVisible(False)\n        nuke.thisNode().knob('Grade_Light_gamma').setVisible(False)\n        nuke.thisNode().knob('cc_light_line').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n        nuke.thisNode().knob('cc_light_space').setVisible(True)\n        nuke.thisNode().knob('Grade_Light_white').setVisible(True)\n        nuke.thisNode().knob('Grade_Light_black').setVisible(True)\n        nuke.thisNode().knob('Grade_Light_multiply').setVisible(True)\n        nuke.thisNode().knob('Grade_Light_gamma').setVisible(True)\n        nuke.thisNode().knob('cc_light_line').setVisible(True)\n\n\n#edge blur\nif nuke.thisKnob().name() == \"edgeblur\": \n\n    if nuke.thisKnob().getValue() == 0:\n        nuke.thisNode().knob('edgeblur_size').setVisible(False)\n        nuke.thisNode().knob('edgeblur_line').setVisible(False)\n        nuke.thisNode().knob('edgeblur_space').setVisible(True)\n\n    if nuke.thisKnob().getValue() == 1:\n        nuke.thisNode().knob('edgeblur_size').setVisible(True)\n        nuke.thisNode().knob('edgeblur_line').setVisible(True)\n        nuke.thisNode().knob('edgeblur_space').setVisible(False)\n\n#solid\nif nuke.thisKnob().name() == \"solid\": \n\n    if nuke.thisKnob().getValue() == 0:\n        nuke.thisNode().knob('solid_col').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n        nuke.thisNode().knob('solid_col').setVisible(True)\n\n#grey out rimlight options\n\nif nuke.thisNode().knob('rimlight').getValue() == 1:\n\n    if nuke.thisNode().input(2):\n        nuke.thisNode().knob('rimlight_pos').setEnabled(False)\n        nuke.thisNode().knob('rimlight_pos_help').setVisible(True)\n    else:\n        nuke.thisNode().knob('rimlight_pos').setEnabled(True)\n        nuke.thisNode().knob('rimlight_pos_help').setVisible(False)\n\n    if nuke.thisNode().input(3):\n        nuke.thisNode().knob('rimlight_mask').setEnabled(True)\n        nuke.thisNode().knob('inverse_rimlight_mask').setEnabled(True)\n        nuke.thisNode().knob('rimlight_mask_help').setVisible(False)\n    else:\n        nuke.thisNode().knob('rimlight_mask').setEnabled(False)\n        nuke.thisNode().knob('inverse_rimlight_mask').setEnabled(False)\n        nuke.thisNode().knob('rimlight_mask_help').setVisible(True)\n\nelse:\n    nuke.thisNode().knob('rimlight_pos_help').setVisible(False)\n    nuke.thisNode().knob('rimlight_mask_help').setVisible(False)\n  \n"

#! C:/Program Files/Nuke15.1v2/nuke-15.1.2.dll -nx
version 15.1 v2
Gizmo {
 addUserKnob {20 User}
 addUserKnob {3 Step}
 Step 1
 addUserKnob {3 MaxEchos}
 MaxEchos {{CTRL.MaxEchos}}
 addUserKnob {7 GradePower R 0 5}
 GradePower {{CTRL.GradePower}}
 addUserKnob {7 DilatePower R 0 5}
 DilatePower {{CTRL.DilatePower}}
}
 Input {
  inputs 0
  name Input1
  xpos 0
 }
 TimeOffset {
  time_offset {{parent.Step}}
  time ""
  name TimeOffset
  xpos 0
  ypos 78
 }
 Grade {
  channels alpha
  white {{"1- pow((TimeOffset.time_offset / (parent.MaxEchos+(parent.MaxEchos/2))), parent.GradePower)" x87 0}}
  name Grade
  xpos 0
  ypos 126
 }
 Dilate {
  size {{"-100 * pow(TimeOffset.time_offset / (parent.MaxEchos-1),DilatePower)"}}
  name Dilate
  xpos 0
  ypos 181
 }
 Premult {
  name Premult
  xpos 0
  ypos 227
 }
 Output {
  name Output1
  xpos 0
  ypos 300
 }
end_group

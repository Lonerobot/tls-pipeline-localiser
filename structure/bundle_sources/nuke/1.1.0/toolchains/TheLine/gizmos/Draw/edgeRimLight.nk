 addUserKnob {20 endGroup n -1}
 addUserKnob {20 email l @}
 addUserKnob {26 created l "" +STARTLINE T "Tool created by Andrea Geremia"}
 addUserKnob {26 ""}
 addUserKnob {26 website l "" +STARTLINE T "andrea.geremia89@gmail.com\nwww.andreageremia.it/tutorial.html"}
}

Group {
 inputs 0
 name CursorToCamShake
 note_font "Verdana Bold"
 selected true
 xpos -611
 ypos 7
 addUserKnob {20 User l "Cursor To Camera Shake"}
 addUserKnob {26 howto l "<font color=\"#8e6e3c\"><b><i>About:  " t "Inspired by tales of this feature inside Shake" T "This will create a Transform node from your cursor movement.<br><br>\n\n - Start Recording<br>\n\n - Tap/Click (hold) and move your cursor<br>\n\n - Stop Recording<br><br>\n\nFor best results keep the stylus in contact with the tablet surface."}
 addUserKnob {26 ""}
 addUserKnob {22 cursorToCam l "Create a Camera Shake" T "from PySide2 import QtWidgets, QtCore, QtGui\nimport nuke\nimport time\n\n# Hold global reference so widget doesn't get garbage collected\nglobal mouse_shake_window\n\nclass MouseShakeRecorder(QtWidgets.QWidget):\n    def __init__(self, start_frame, parent=None):\n        super(MouseShakeRecorder, self).__init__(parent)\n        self.setWindowTitle(\"Mouse Shake Recorder\")\n        self.setFixedSize(500, 400)\n        self.setMouseTracking(True)\n        self.setFocusPolicy(QtCore.Qt.StrongFocus)\n\n        self.points = \[]\n        self.recording = False\n        self.start_time = None\n        self.fps = 24\n        self.start_frame = int(start_frame)\n        self.target_node = None\n\n        layout = QtWidgets.QVBoxLayout(self)\n        self.label = QtWidgets.QLabel(\"Move mouse to record shake\")\n        self.label.setAlignment(QtCore.Qt.AlignCenter)\n        layout.addWidget(self.label)\n\n        self.record_btn = QtWidgets.QPushButton(\"Start Recording\")\n        self.stop_btn = QtWidgets.QPushButton(\"Stop\")\n        layout.addWidget(self.record_btn)\n        layout.addWidget(self.stop_btn)\n\n        self.record_btn.clicked.connect(self.countdown_and_start)\n        self.stop_btn.clicked.connect(self.stop_recording)\n\n        self.setStyleSheet(\"background-color: #2a2a2a; color: white;\")\n\n    def countdown_and_start(self):\n        for i in reversed(range(1, 4)):\n            self.label.setText(f\"Recording in \{i\}...\")\n            QtWidgets.QApplication.processEvents()\n            time.sleep(1)\n        self.start_recording()\n\n    def start_recording(self):\n        self.points = \[]\n        self.recording = True\n        self.start_time = time.time()\n        self.label.setText(\"Recording... (move mouse/stylus)\")\n\n    def stop_recording(self):\n        if not self.recording:\n            return\n        self.recording = False\n        self.label.setText(\"Stopped. Applying to node...\")\n        self.send_to_nuke()\n        self.label.setText(\"Done. You can record again.\")\n        self.close()   # closes the window\n\n    def keyPressEvent(self, event):\n        if event.key() == QtCore.Qt.Key_Escape:\n            self.stop_recording()\n\n    def mouseMoveEvent(self, event):\n        if self.recording:\n            t = time.time() - self.start_time\n            x = event.x()\n            y = event.y()\n            self.points.append((t, x, y))\n\n    def send_to_nuke(self):\n        if not self.points:\n            nuke.message(\"No movement recorded.\")\n            return\n\n        node = self.target_node\n\n        if not node or not node.knob(\"translate\"):\n            # If no valid node provided, create a new one now\n            selected = nuke.selectedNodes()\n            xpos, ypos = 0, 0\n            if selected:\n                base_node = selected\[0]\n                xpos = base_node.xpos()\n                ypos = base_node.ypos() + 100\n\n            nuke.selectAll()\n            nuke.invertSelection()  # Deselect all to avoid auto-connecting\n            node = nuke.createNode(\"Transform\", inpanel=False)\n            node.setName(\"MouseShake_Transform\")\n            node.setXYpos(xpos, ypos)\n            self.target_node = node\n            print(\"Created new Transform node: MouseShake_Transform\")\n\n        node\[\"translate\"].setAnimated()\n        base_time = self.points\[0]\[0]\n\n        for t, x, y in self.points:\n            frame = self.start_frame + int((t - base_time) * self.fps)\n            rel_x = (x - self.width() / 2) / 10.0\n            rel_y = (y - self.height() / 2) / 10.0\n            node\[\"translate\"].setValueAt(rel_x, frame, 0)\n            node\[\"translate\"].setValueAt(rel_y, frame, 1)\n\n        node.setSelected(True)\n        nuke.root().setModified(True)\n\n\ndef get_main_window():\n    for widget in QtWidgets.QApplication.topLevelWidgets():\n        if widget.objectName() == 'Foundry::UI::DockMainWindow':\n            return widget\n    return None\n\ndef launch_mouse_shake_recorder(group_node):\n    global mouse_shake_window\n\n    start_frame = nuke.root().firstFrame()\n\n    if group_node.knob(\"startframe\"):\n        try:\n            start_frame = int(group_node\[\"startframe\"].value())\n        except Exception as e:\n            nuke.message(f\"Error reading 'startframe': \{str(e)\}\")\n            start_frame = nuke.root().firstFrame()  # safe fallback\n    else:\n        nuke.message(\"Group is missing 'startframe' knob.\")\n        start_frame = nuke.root().firstFrame()\n\n    with nuke.root():\n        transform_node = None\n        selected = nuke.selectedNodes()\n        if selected and selected\[0].Class() == \"Transform\":\n            transform_node = selected\[0]\n            print(\"Using selected Transform node.\")\n\n        mouse_shake_window = MouseShakeRecorder(start_frame=start_frame, parent=get_main_window())\n        mouse_shake_window.setWindowFlags(\n            QtCore.Qt.Window | QtCore.Qt.WindowStaysOnTopHint\n        )\n        mouse_shake_window.show()\n        mouse_shake_window.raise_()\n        mouse_shake_window.activateWindow()\n        mouse_shake_window.target_node = transform_node\n\n\nlaunch_mouse_shake_recorder(nuke.thisNode())" +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {3 startframe l "Start Frame"}
 startframe 1001
 addUserKnob {20 _1 l "" +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {26 versionInfo l "" t "Change Log:\n\n- Revised ontop logic\n- added inbuilt Transform creation" +STARTLINE T "<b>v1.4</b> <font color=\"#8e6e3c\"><i>   Created by <b>Adam Kelway</b> Updated August 19, 2025"}
}

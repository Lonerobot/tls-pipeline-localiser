 knobChanged "#colorfill\nif nuke.thisKnob().name() == \"output\": \n\n    if nuke.thisKnob().value() == \"Color Fill\" or nuke.thisKnob().value() == \"Color Replace\":\n        nuke.thisGroup().knob('colorfill').setVisible(True)\n        \n        if nuke.thisKnob().value() == \"Color Fill\":\n            nuke.thisGroup().knob('colorfill_help').setVisible(True)\n            nuke.thisGroup().knob('colorreplace_help').setVisible(False)\n            \n        if nuke.thisKnob().value() == \"Color Replace\":\n            nuke.thisGroup().knob('colorfill_help').setVisible(False)\n            nuke.thisGroup().knob('colorreplace_help').setVisible(True)\n        \n    else:\n        nuke.thisGroup().knob('colorfill').setVisible(False)\n        nuke.thisGroup().knob('colorfill_help').setVisible(False)\n        nuke.thisGroup().knob('colorreplace_help').setVisible(False)"

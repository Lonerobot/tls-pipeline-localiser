 color_picker {{"\[python 0\\ if\\ not\\ nuke.thisNode().input(0)\\ else\\ (\\n\\ \\ \\ \\ 0\\ if\\ not\\ (0\\ <\\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[0\\]\\ <\\ nuke.thisNode().input(0).width()\\ and\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ 0\\ <\\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[1\\]\\ <\\ nuke.thisNode().input(0).height())\\ else\\ \\n\\ \\ \\ \\ nuke.thisNode().input(0).sample(\\n\\ \\ \\ \\ \\ \\ \\ \\ \\\"red\\\",\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[0\\]\\ /\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ float(nuke.activeViewer().node()\\\[\\\"downrez\\\"\\].value()\\ if\\ nuke.activeViewer()\\ else\\ 1),\\n\\ \\ \\ \\ \\ \\ \\ \\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[1\\]\\ /\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ float(nuke.activeViewer().node()\\\[\\\"downrez\\\"\\].value()\\ if\\ nuke.activeViewer()\\ else\\ 1)\\n\\ \\ \\ \\ )\\n)]"} {"\[python 0\\ if\\ not\\ nuke.thisNode().input(0)\\ else\\ (\\n\\ \\ \\ \\ 0\\ if\\ not\\ (0\\ <\\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[0\\]\\ <\\ nuke.thisNode().input(0).width()\\ and\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ 0\\ <\\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[1\\]\\ <\\ nuke.thisNode().input(0).height())\\ else\\ \\n\\ \\ \\ \\ nuke.thisNode().input(0).sample(\\n\\ \\ \\ \\ \\ \\ \\ \\ \\\"green\\\",\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[0\\]\\ /\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ float(nuke.activeViewer().node()\\\[\\\"downrez\\\"\\].value()\\ if\\ nuke.activeViewer()\\ else\\ 1),\\n\\ \\ \\ \\ \\ \\ \\ \\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[1\\]\\ /\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ float(nuke.activeViewer().node()\\\[\\\"downrez\\\"\\].value()\\ if\\ nuke.activeViewer()\\ else\\ 1)\\n\\ \\ \\ \\ )\\n)]"} {"\[python 0\\ if\\ not\\ nuke.thisNode().input(0)\\ else\\ (\\n\\ \\ \\ \\ 0\\ if\\ not\\ (0\\ <\\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[0\\]\\ <\\ nuke.thisNode().input(0).width()\\ and\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ \\ 0\\ <\\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[1\\]\\ <\\ nuke.thisNode().input(0).height())\\ else\\ \\n\\ \\ \\ \\ nuke.thisNode().input(0).sample(\\n\\ \\ \\ \\ \\ \\ \\ \\ \\\"blue\\\",\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[0\\]\\ /\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ float(nuke.activeViewer().node()\\\[\\\"downrez\\\"\\].value()\\ if\\ nuke.activeViewer()\\ else\\ 1),\\n\\ \\ \\ \\ \\ \\ \\ \\ nuke.thisNode()\\\[\\\"sample_point\\\"\\].value()\\\[1\\]\\ /\\ \\n\\ \\ \\ \\ \\ \\ \\ \\ float(nuke.activeViewer().node()\\\[\\\"downrez\\\"\\].value()\\ if\\ nuke.activeViewer()\\ else\\ 1)\\n\\ \\ \\ \\ )\\n)]"}}

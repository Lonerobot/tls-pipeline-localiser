 addUserKnob {26 _1 l "" +STARTLINE T " "}
 addUserKnob {22 add_sampling_point l "<b>ADD SAMPLE</b>" T "import nuke\n\n## GLOBAL VARIABLES\n\nnode = nuke.thisGroup()  # The Group node\ncolor_picker_knob = node.knob(\"color_picker\")\ncount = len(\[k for k in node.knobs() if k.startswith(\"key_color\")]) # Get the current count of sample points\n\n## CREATE KNOBS\n# Create RGB color knob from sample point and set its values\nsample_knob = nuke.Color_Knob(f\"key_color_\{count\}\", f\"key_color \{count\}\")\nnode.addKnob(sample_knob)\n\nif color_picker_knob:\n    sample_knob.setExpression(\"color_picker.r\", 0)\n    sample_knob.setExpression(\"color_picker.g\", 1)\n    sample_knob.setExpression(\"color_picker.b\", 2)\n    sample_knob.clearAnimated()\n    \n    \n# Create a checkbox knob labeled \"disable\"\ndisable_knob = nuke.Boolean_Knob(f\"disable_\{count\}\", \"disable\")\nnode.addKnob(disable_knob)\n\n  \n## CREATE NODES INSIDE GROUP   \n\nwith node:\n    \n    x_offset = -100  # Horizontal offset for each set of nodes\n    \n    # Set a base X and Y position for \"branch_init\"\n    branch_init_node = nuke.toNode(\"branch_init\")    \n                           \n    # Create the Shuffle node\n    shuffle_node = nuke.createNode(\"Shuffle\", inpanel=False)\n    shuffle_node.setName(f\"Shuffle_\{count\}\")\n    shuffle_node.setXpos(branch_init_node.xpos() + x_offset * (count+1))\n    shuffle_node.setYpos(branch_init_node.ypos())\n    shuffle_node\[\"red\"].setValue(\"white\")\n    shuffle_node\[\"green\"].setValue(\"white\")\n    shuffle_node\[\"blue\"].setValue(\"white\")\n    shuffle_node\[\"alpha\"].setValue(\"white\")\n    shuffle_node.setInput(0, branch_init_node)\n\n    # Create the Grade node\n    grade_node = nuke.createNode(\"Grade\", inpanel=False)\n    grade_node.setName(f\"Grade_\{count\}\")\n    grade_node\[\"multiply\"].setSingleValue(False)        \n    grade_node\[\"multiply\"].setExpression(f\"parent.\{sample_knob.name()\}.r\", 0)  # Red channel\n    grade_node\[\"multiply\"].setExpression(f\"parent.\{sample_knob.name()\}.g\", 1)  # Green channel\n    grade_node\[\"multiply\"].setExpression(f\"parent.\{sample_knob.name()\}.b\", 2)  # Blue channel   \n\n    # Create the Merge (Difference) node\n    merge_node = nuke.createNode(\"Merge2\", inpanel=False)\n    merge_node.setName(f\"Merge_Diff_\{count\}\")\n    merge_node.setXpos(grade_node.xpos())\n    merge_node.setYpos(grade_node.ypos()+50)\n    merge_node.setInput(0, grade_node)  # A input\n    merge_node.setInput(1, branch_init_node)  # B input\n    merge_node\[\"operation\"].setValue(\"difference\")\n    \n    #Create Saturation node\n    saturation_node = nuke.createNode(\"Saturation\",inpanel=False)\n    saturation_node.setName(f\"Saturation_\{count\}\")\n    saturation_node.setXpos(merge_node.xpos())\n    saturation_node.setYpos(merge_node.ypos()+50)\n    saturation_node.setInput(0, merge_node)\n    saturation_node\['saturation'].setValue(\"0\")\n    \n    #Create Clamp node\n    clamp_node = nuke.createNode(\"Clamp\", inpanel=False)\n    clamp_node.setName(f\"Clamp_\{count\}\")\n    clamp_node.setXpos(saturation_node.xpos())\n    clamp_node.setYpos(saturation_node.ypos()+30)\n    clamp_node.setInput(0, saturation_node)\n    clamp_node\['maximum'].setExpression(\"parent.threshold\")\n    clamp_node\['MaxClampTo_enable'].setValue(True)\n        \n    #Create Invert Node\n    invert_node = nuke.createNode(\"Invert\", inpanel=False)\n    invert_node.setName(f\"Invert_\{count\}\")\n    invert_node.setXpos(clamp_node.xpos())\n    invert_node.setYpos(clamp_node.ypos()+40)\n    invert_node.setInput(0, clamp_node)\n    invert_node\['channels'].setValue(\"rgb\")    \n    \n    #Create shuffle node to disable this picker\n    disable_node = nuke.createNode(\"Shuffle\", inpanel=False)\n    disable_node.setName(f\"Disable_\{count\}\")\n    disable_node.setXpos(invert_node.xpos())\n    disable_node.setYpos(invert_node.ypos()+30)\n    disable_node\[\"red\"].setValue(\"black\")\n    disable_node\[\"green\"].setValue(\"black\")\n    disable_node\[\"blue\"].setValue(\"black\")\n    disable_node\[\"alpha\"].setValue(\"black\")\n    disable_node\[\"disable\"].setExpression(f\"!disable_\{count\}\")\n    disable_node.setInput(0, invert_node)\n    \n    disable_node.setSelected(False) \n\n    # Connect the Merge node to merge_all_mattes\n    merge_all_mattes = nuke.toNode(\"merge_all_mattes\")\n    if merge_all_mattes:\n        input_count = merge_all_mattes.inputs()\n        merge_all_mattes.setInput(input_count+1 if input_count != 2 else 3, disable_node)\n        \n        \n    multiply_alpha_node = nuke.toNode(\"Multiply_Alpha\")\n    multiply_alpha_node\['disable'].setValue(False)     \n\n# Define the remove function inline\nremove_script = f\"\"\"\nimport nuke\nnode = nuke.thisGroup()\ncount = \{count\}\n\n# Get nodes to delete\nshuffle_node = node.node('Shuffle_' + str(count))\ngrade_node = node.node('Grade_' + str(count))\nmerge_node = node.node('Merge_Diff_' + str(count))\nsaturation_node = node.node('Saturation_' + str(count))\nclamp_node = node.node('Clamp_' + str(count))\ninvert_node = node.node('Invert_' + str(count))\ndisable_node = node.node('Disable_' + str(count))\n\n# Get the merge_all_mattes node\nmerge_all_mattes = nuke.toNode('merge_all_mattes')\n\n# Disconnect the Merge node from merge_all_mattes\nif invert_node and merge_all_mattes:\n    for i in range(merge_all_mattes.inputs()):\n        if merge_all_mattes.input(i) == disable_node:\n            merge_all_mattes.setInput(i, None)\n\n# Delete the nodes\nfor n in \[shuffle_node, grade_node, merge_node, saturation_node, clamp_node, invert_node, disable_node]:\n    if n:\n        nuke.delete(n)\n\n# Remove the sample knob and button\nnode.removeKnob(node.knob('key_color_\{count\}'))\nnode.removeKnob(node.knob('remove_\{count\}'))\nnode.removeKnob(node.knob('disable_\{count\}'))\n\n# Check if the count is now zero, meaning no more samples exist\nmultiply_alpha_node = nuke.toNode(\"Multiply_Alpha\")\nif multiply_alpha_node:\n    # If no remaining sample knobs, disable Multiply_Alpha\n    if count == 0:\n        multiply_alpha_node\['disable'].setValue(True)\n        \n    else:\n        multiply_alpha_node\['disable'].setValue(False)\n\n\"\"\"\n\n# Create the remove button\nremove_btn = nuke.PyScript_Knob(f\"remove_\{count\}\", \"Remove\", remove_script)\nnode.addKnob(remove_btn)\nnode.knob('color_picker').setFlag(0)\n" +STARTLINE}
 addUserKnob {26 _2 l "" +STARTLINE T " "}

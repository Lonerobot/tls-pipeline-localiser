set cut_paste_input [stack 0]
version 12.2 v3
push $cut_paste_input
Transform {
 translate {{frame*xspeed} {frame*yspeed}}
 center {1686 1014}
 name Speed_Transform
 selected true
 xpos 7990
 ypos 615
 addUserKnob {20 SpeedControls l "Speed Controls"}
 addUserKnob {7 yspeed l "Y Speed" R -500 500}
 addUserKnob {7 xspeed l "X Speed" R -500 500}
}

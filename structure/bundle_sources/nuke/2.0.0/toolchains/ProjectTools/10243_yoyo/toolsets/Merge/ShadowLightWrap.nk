 addUserKnob {22 rndClrs0 l "<font style=\"background-color:#7d97a7\"> <img size=\"8\" src=\"Read.png\"> PAINT </font>" T "import colorsys\nn=nuke.thisNode()\nlist=\[u' PAINT ', u' 2D ANIMATION ', u' CAMERA ', u' RETIME ', u' GROUP ', u'3D SCENE', u' REFERENCE ', u' PUBLISHED ', u'IMPORTANT']\nn\['icon'].setValue('Read.png')\nR,G,B= \[0.561, 0.246, 0.655]\nR,G,B=colorsys.hsv_to_rgb(R,G,B)\nn\['tile_color'].setValue( int('%02x%02x%02x%02x' % (R*255,G*255,B*255,255), 16 ))\nif ((n\['label'].getValue()=='') or (n\['label'].getValue() in list)):\n   n\['label'].setValue(' PAINT ')\n\nallnodes=nuke.allNodes()\nlist=\[]\nnd_name='%s_backdrop' % ' PAINT '\ncurName=n\['name'].getValue().split(nd_name)\n\nif ((len(curName)>0) and (not curName\[0]=='')):\n    for nd in allnodes:\n        splt=nd.name().split(nd_name)\n        if (len(splt)>1):\n            num=splt\[1]\n            if num.isdigit():\n                list.append(int(num))\n    if len(list)>0:\n        next=int(sorted(list)\[-1])+1 \n    else: next=1\n    n\['name'].setValue('%s%s' % (nd_name,next))" +STARTLINE}

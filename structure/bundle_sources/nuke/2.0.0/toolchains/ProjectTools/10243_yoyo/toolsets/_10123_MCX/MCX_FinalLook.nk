push 0
Group {
 inputs 3
 name MCX_FINAL_LOOK
 knobChanged "\nif nuke.thisKnob().name() == \"chromaab\": \n\n    if nuke.thisKnob().getValue() == 0:\n      nuke.thisNode().knob('abredscale').setVisible(False)\n      nuke.thisNode().knob('abgreenscale').setVisible(False)\n      nuke.thisNode().knob('abbluescale').setVisible(False)\n      nuke.thisNode().knob('abredblur').setVisible(False)\n      nuke.thisNode().knob('abgreenblur').setVisible(False)\n      nuke.thisNode().knob('abblueblur').setVisible(False)\n      nuke.thisNode().knob('chromaab_line').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n      nuke.thisNode().knob('abredscale').setVisible(True)\n      nuke.thisNode().knob('abgreenscale').setVisible(True)\n      nuke.thisNode().knob('abbluescale').setVisible(True)\n      nuke.thisNode().knob('abredblur').setVisible(True)\n      nuke.thisNode().knob('abgreenblur').setVisible(True)\n      nuke.thisNode().knob('abblueblur').setVisible(True)\n      nuke.thisNode().knob('chromaab_line').setVisible(True)\n\nif nuke.thisKnob().name() == \"camshake\": \n\n    if nuke.thisKnob().getValue() == 0:\n      nuke.thisNode().knob('camshakeamplitude').setVisible(False)\n      nuke.thisNode().knob('camshakescale').setVisible(False)\n      nuke.thisNode().knob('camshakefrequency').setVisible(False)\n      nuke.thisNode().knob('camshakembamt').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n      nuke.thisNode().knob('camshakeamplitude').setVisible(True)\n      nuke.thisNode().knob('camshakescale').setVisible(True)\n      nuke.thisNode().knob('camshakefrequency').setVisible(True)\n      nuke.thisNode().knob('camshakembamt').setVisible(True)\n\n"
 tile_color 0xffef00ff
 gl_color 0xff0000ff
 note_font "Verdana Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold Bold"
 note_font_size 30
 note_font_color 0xffff
 selected true
 xpos 465
 ypos 6340
 addUserKnob {20 controls l Controls}
 addUserKnob {4 outputformat l "Output Format" M {HD MCX_Fullres}}
 outputformat MCX_Fullres
 addUserKnob {26 ""}
 addUserKnob {6 camshake l "Use Camera Shake?" +STARTLINE}
 addUserKnob {14 camshakeamplitude l Amplitude +HIDDEN R 0 100}
 camshakeamplitude {40 80}
 addUserKnob {7 camshakescale l scaling +HIDDEN R 0 0.1}
 camshakescale 0.03
 addUserKnob {7 camshakefrequency l frequency +HIDDEN}
 camshakefrequency 0.1
 addUserKnob {7 camshakembamt l "Motion Blur amount" +HIDDEN}
 camshakembamt 0.25
 addUserKnob {26 ""}
 addUserKnob {6 stmap l "Use STMap?" +STARTLINE}
 stmap true
 addUserKnob {26 ""}
 addUserKnob {6 chromaab l "Use Chromatic Aberration?" +STARTLINE}
 chromaab true
 addUserKnob {7 abredscale l "<font  color='#de0000'>Red Channel scale</font>" R 0.8 1.2}
 abredscale 1.002
 addUserKnob {7 abgreenscale l "<font  color='#00de00'>Green Channel scale</font>" R 0.8 1.2}
 abgreenscale 1
 addUserKnob {7 abbluescale l "<font  color='#0000de'>Blue Channel scale</font>" R 0.8 1.2}
 abbluescale 0.9982
 addUserKnob {26 chromaab_line l "" +STARTLINE}
 addUserKnob {7 abredblur l "<font color='#de0000'>Red Channel Blur</font>" R 0 100}
 addUserKnob {7 abgreenblur l "<font color='#00de00'>Green Channel Blur</font>" R 0 100}
 addUserKnob {7 abblueblur l "<font color='#0000de'>Blue Channel Blur</font>" R 0 100}
 abblueblur 2
 addUserKnob {26 ""}
 addUserKnob {6 convolve l "Use Convolve?" +STARTLINE}
 convolve true
 addUserKnob {26 ""}
 addUserKnob {14 reformat_scale l "Crop adjust" R 0.1 10}
 reformat_scale 1
 addUserKnob {26 knobChanged_data l "" +STARTLINE +INVISIBLE T "nuke.selectedNode().knob('knobChanged').setValue('''\nif nuke.thisKnob().name() == \"chromaab\": \n\n    if nuke.thisKnob().getValue() == 0:\n      nuke.thisNode().knob('abredscale').setVisible(False)\n      nuke.thisNode().knob('abgreenscale').setVisible(False)\n      nuke.thisNode().knob('abbluescale').setVisible(False)\n      nuke.thisNode().knob('abredblur').setVisible(False)\n      nuke.thisNode().knob('abgreenblur').setVisible(False)\n      nuke.thisNode().knob('abblueblur').setVisible(False)\n      nuke.thisNode().knob('chromaab_line').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n      nuke.thisNode().knob('abredscale').setVisible(True)\n      nuke.thisNode().knob('abgreenscale').setVisible(True)\n      nuke.thisNode().knob('abbluescale').setVisible(True)\n      nuke.thisNode().knob('abredblur').setVisible(True)\n      nuke.thisNode().knob('abgreenblur').setVisible(True)\n      nuke.thisNode().knob('abblueblur').setVisible(True)\n      nuke.thisNode().knob('chromaab_line').setVisible(True)\n\nif nuke.thisKnob().name() == \"camshake\": \n\n    if nuke.thisKnob().getValue() == 0:\n      nuke.thisNode().knob('camshakeamplitude').setVisible(False)\n      nuke.thisNode().knob('camshakescale').setVisible(False)\n      nuke.thisNode().knob('camshakefrequency').setVisible(False)\n      nuke.thisNode().knob('camshakembamt').setVisible(False)\n\n    if nuke.thisKnob().getValue() == 1:\n      nuke.thisNode().knob('camshakeamplitude').setVisible(True)\n      nuke.thisNode().knob('camshakescale').setVisible(True)\n      nuke.thisNode().knob('camshakefrequency').setVisible(True)\n      nuke.thisNode().knob('camshakembamt').setVisible(True)\n\n''')"}
}

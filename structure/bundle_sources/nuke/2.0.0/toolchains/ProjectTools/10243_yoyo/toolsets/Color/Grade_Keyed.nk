set cut_paste_input [stack 0]
version 12.2 v3
push 0
push $cut_paste_input
Group {
 inputs 2
 name Grade_Keyed
 tile_color 0x7ca5f4ff
 selected true
 xpos -260
 ypos -105
 addUserKnob {20 Grade_Keyed}
 addUserKnob {26 ColourSampler l "Colour Sampler" t "This node is usful for grading 2d animation. pipe in the unedited 2d colour laer to the key input us the 2d point controller to select the colour to key. " -STARTLINE}
 addUserKnob {22 ToolTip l "Tool Tip " T "nuke.message('Use this node to grade 2D animation. pipe in the unaltered colour layer to the key input, use the picker controls to select the colour to key')" +STARTLINE}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 ColourPicker l "Colour Picker" T SampleColour.pc}
 addUserKnob {41 SetPosition l "Set Colour" -STARTLINE T SampleColour.SetPosition}
 addUserKnob {41 erode l Erode T Erode1.size}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 channels T Grade_Main.channels}
 addUserKnob {41 blackpoint T Grade_Main.blackpoint}
 addUserKnob {41 whitepoint T Grade_Main.whitepoint}
 addUserKnob {41 black l lift T Grade_Main.black}
 addUserKnob {41 white l gain T Grade_Main.white}
 addUserKnob {41 multiply T Grade_Main.multiply}
 addUserKnob {41 add l offset T Grade_Main.add}
 addUserKnob {41 gamma T Grade_Main.gamma}
 addUserKnob {41 gradeonwhite l "Grade On White" T switch_gradeonWhite.gradeonwhite}
 addUserKnob {41 black_clamp l "black clamp" -STARTLINE T Grade_Main.black_clamp}
 addUserKnob {41 white_clamp l "white clamp" -STARTLINE T Grade_Main.white_clamp}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 mix T Merge4_mix.mix}
}
 Input {
  inputs 0
  name Key
  xpos 70
  ypos -465
  number 1
 }
set Ne2743400 [stack 0]
 NoOp {
  name SampleColour
  xpos -150
  ypos -297
  addUserKnob {20 User}
  addUserKnob {12 pc}
  pc {2156 1216}
  addUserKnob {13 PositionValue}
  PositionValue {0.07227184623 0.0595112294 0.06662592292}
  addUserKnob {18 pixelValues}
  pixelValues {{"\[python -execlocal my\\ =\\ nuke.thisNode()\\n\\nPosx\\ =\\ my.knob('pc').value(0)\\nPosy\\ =\\ my.knob('pc').value(1)\\n\\nret\\ =\\ nuke.sample(nuke.thisNode(),\\\"r\\\",Posx,Posy)\\n\\nret]"} {"\[python -execlocal my\\ =\\ nuke.thisNode()\\n\\nPosx\\ =\\ my.knob('pc').value(0)\\nPosy\\ =\\ my.knob('pc').value(1)\\n\\nret\\ =\\ nuke.sample(nuke.thisNode(),\\\"g\\\",Posx,Posy)\\n\\nret]"} {"\[python -execlocal my\\ =\\ nuke.thisNode()\\n\\nPosx\\ =\\ my.knob('pc').value(0)\\nPosy\\ =\\ my.knob('pc').value(1)\\n\\nret\\ =\\ nuke.sample(nuke.thisNode(),\\\"b\\\",Posx,Posy)\\n\\nret]"}}
  addUserKnob {6 pixelValues_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
  addUserKnob {22 SetPosition T "m = nuke.thisNode()\nr, g, b = m\['pixelValues'].getValue()\nm\['PositionValue'].setValue(\[r, g, b])" +STARTLINE}
 }
 Input {
  inputs 0
  name mask
  label Mask
  xpos 400
  ypos 105
  number 2
 }
set Ne8801400 [stack 0]
push $Ne2743400
 Shuffle2 {
  fromInput1 {{0} B}
  fromInput2 {{0} B}
  mappings "4 white -1 -1 rgba.green 0 1 white -1 -1 rgba.blue 0 2 white -1 -1 rgba.alpha 0 3 white -1 -1 rgba.red 0 0"
  name Shuffle1
  xpos 290
  ypos -369
 }
 Grade {
  white {{parent.SampleColour.PositionValue} {parent.SampleColour.PositionValue} {parent.SampleColour.PositionValue} {1}}
  name Grade1
  xpos 290
  ypos -297
 }
push $Ne2743400
 Difference {
  inputs 2
  name Difference1
  xpos 70
  ypos -207
 }
 Grade {
  channels alpha
  whitepoint 0
  name Grade2_threshold
  xpos 70
  ypos -135
 }
 Invert {
  name Invert1
  xpos 70
  ypos -87
 }
 Clamp {
  channels alpha
  name Clamp1
  xpos 70
  ypos -51
 }
 Shuffle2 {
  fromInput1 {{0} B}
  fromInput2 {{0} B}
  mappings "4 rgba.alpha 0 3 rgba.alpha 0 3 rgba.alpha 0 3 rgba.red 0 0 rgba.alpha 0 3 rgba.green 0 1 rgba.alpha 0 3 rgba.blue 0 2"
  name Shuffle2
  xpos 70
  ypos -9
 }
 Erode {
  size 0
  name Erode1
  xpos 70
  ypos 81
 }
set N83436c00 [stack 0]
 Shuffle2 {
  fromInput1 {{0} B}
  fromInput2 {{0} B}
  mappings "4 rgba.alpha 0 3 rgba.alpha 0 3 rgba.alpha 0 3 rgba.red 0 0 rgba.alpha 0 3 rgba.green 0 1 rgba.alpha 0 3 rgba.blue 0 2"
  name Shuffle3
  xpos 70
  ypos 207
 }
set Nedde6c00 [stack 0]
 Grade {
  blackpoint {0}
  whitepoint {1}
  black {0}
  white {1 1 1 1}
  white_panelDropped true
  multiply {1}
  add {0}
  gamma {1}
  name Grade_Main
  xpos 70
  ypos 279
 }
 set Ce27a0800 [stack 0]
 Merge2 {
  inputs 2
  operation stencil
  name Merge3
  xpos 70
  ypos 351
 }
 Input {
  inputs 0
  name Input1
  xpos -810
  ypos -249
 }
set Ne2743800 [stack 0]
 Dot {
  name Dot3
  xpos -226
  ypos -246
 }
 Merge2 {
  inputs 2
  name Merge1
  xpos -260
  ypos 351
 }
push $Ne8801400
push $N83436c00
 Merge2 {
  inputs 2
  operation stencil
  name Merge2
  xpos -150
  ypos 207
 }
push $Ne2743800
 Dot {
  name Dot1
  xpos -776
  ypos 210
 }
set N83437800 [stack 0]
clone $Ce27a0800 {
  inputs 1+1
  xpos -370
  ypos 207
  selected false
 }
 Switch {
  inputs 2
  which {{parent.switch_gradeonWhite.gradeonwhite}}
  name Switch1
  xpos -370
  ypos 495
 }
push $N83437800
 Merge2 {
  inputs 2
  mix {1}
  name Merge4_mix
  xpos -810
  ypos 495
 }
 Output {
  name Output1
  xpos -370
  ypos 855
 }
 NoOp {
  inputs 0
  name switch_gradeonWhite
  xpos -590
  ypos 375
  addUserKnob {20 User}
  addUserKnob {6 gradeonwhite l "Grade On White" +STARTLINE}
 }
push $Nedde6c00
 Viewer {
  frame_range 1-100
  name Viewer1
  selected true
  xpos 70
  ypos 135
 }
end_group

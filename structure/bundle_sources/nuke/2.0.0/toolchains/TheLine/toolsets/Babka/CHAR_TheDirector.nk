  addUserKnob {7 PositionY t "This changes the Y position of the curve in the graph editor along the Y axis.\n\nKeyframing this will create a new curve which the random curve will be guided along.\n" R -4 4}
  PositionY 1
 }
 Output {
  name Output1
  xpos 289
  ypos -392
 }
end_group

set cut_paste_input [stack 0]
version 15.1 v2
push $cut_paste_input
Group {
 name HoldDrawings
 tile_color 0xafa25cff
 selected true
 xpos 840
 ypos 87
 addUserKnob {20 HoldDrawings_1 l "Hold Drawings"}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 go l "Find Drawings" t "Looks through the incoming animation to find where there are new drawings. " T CurveTool500.go}
 addUserKnob {41 Threshold l "Sensitivity Threshold" t "Here you can adjust the sensitivity of what gets picked up as a held drawing. \n\nHelpful when used on 3D renders that looked stepped but compression or textures are moving on every frame." T Dilate1.size}
 addUserKnob {6 viewtrigger l "View Trigger Matte" t "View the matte that triggers a key Frame. \n\nkey frames are created when there is white visible" +STARTLINE}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 CreateHold l "Create Frame Hold" t "Creates a frame hold on each new drawing. Can be viewed in the Curve Editor." T NoOp1.Script}
 addUserKnob {41 lookup l "Held Frames" T TimeWarp1.lookup}
}
 NoOp {
  inputs 0
  name NoOp1
  xpos -810
  ypos 687
  addUserKnob {20 User}
  addUserKnob {22 reset +STARTLINE}
  addUserKnob {22 Script T "import nuke\n\n# Get first and last frame from root\nff = int(nuke.root()\['first_frame'].value())\nlf = int(nuke.root()\['last_frame'].value())\n\n# Access the CurveTool node\ncurve_tool_node = nuke.toNode(\"CurveTool500\")\n\n# Store frames where intensity is 1\nframes = \[]\n\nfor frame in range(ff, lf + 1):\n    v = curve_tool_node\[\"intensitydata\"].getValueAt(frame)\n    \n    # Check if intensity is exactly 1\n    if v and v\[0] == 1:\n        frames.append(frame)\n        frames.append(ff)\n\n# Access the TimeWarp node\ntimewarp_node = nuke.toNode(\"TimeWarp1\")\nlookup_knob = timewarp_node\['lookup']\n\n# Clear existing animation and set the knob as animated\nlookup_knob.clearAnimated()\nlookup_knob.setAnimated()\n\n# Get the animation curve\nanimations = lookup_knob.animations()\nif not animations:\n    raise RuntimeError(\"No animation curve found on 'lookup' knob.\")\n\nanimation_curve = animations\[0]\n\n# Set keyframes with CONSTANT interpolation\nfor i in frames:\n    print(i)\n    key = animation_curve.setKey(i, i)\n    key.interpolation = nuke.CONSTANT\n" +STARTLINE}
 }
